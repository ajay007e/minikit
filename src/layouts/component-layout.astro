---
import DocsLayout from './docs-layout.astro';
import { components } from '../data/components';

interface Props {
  slug: string;
  title: string;
  description: string;
  nav?: {
    href: string;
    label: string;
  }[];
}

const { slug, title, description, nav = [] } = Astro.props;

const index = components.findIndex((component) => component.slug === slug);

const previous = index > 0 ? components[index - 1] : null;

const next = index < components.length - 1 ? components[index + 1] : null;
---

<DocsLayout title={title} description={description} page={slug} nav={nav}>
  <header class="component-header">
    <h1>{title}</h1>

    <p class="lead">
      {description}
    </p>
  </header>

  <slot />

  <nav class="component-pagination">
    {
      previous && (
        <a href={previous.href} class="component-pagination-link">
          <span>Previous</span>
          <strong>{previous.title}</strong>
        </a>
      )
    }

    {
      next && (
        <a href={next.href} class="component-pagination-link component-pagination-next">
          <span>Next</span>
          <strong>{next.title}</strong>
        </a>
      )
    }
  </nav>
</DocsLayout>
