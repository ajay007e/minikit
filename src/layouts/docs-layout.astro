---
import BaseLayout from './base-layout.astro';
import Sidebar from '../components/sidebar.astro';
import PageNav from '../components/page-nav.astro';

import '../styles/docs.css';

interface NavItem {
  href: string;
  label: string;
}

interface Props {
  title: string;
  description?: string;
  page?: string;
  nav?: NavItem[];
}

const { title, description = '', page = '', nav = [] } = Astro.props;
---

<BaseLayout title={`${title} · MiniKit`} description={description}>
  <div class="docs-shell">
    <Sidebar page={page} />

    <article class="content">
      <slot />
    </article>

    <PageNav items={nav} />
  </div>
  <script slot="scripts" src={`${import.meta.env.BASE_URL}scripts/docs.js`}></script>
</BaseLayout>
