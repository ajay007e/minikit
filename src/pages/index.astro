---
import BaseLayout from '../layouts/base-layout.astro';
import Playground from '../components/playground.astro';

import '../styles/home.css';
import '../styles/playground.css';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="MiniKit" description="Build modern interfaces with simple HTML.">
  <main class="home">

    <section class="hero container">
      <span data-badge>v0.0.3</span>
      <h1>Build modern interfaces with simple HTML.</h1>
      <p class="hero-subtitle">A tiny HTML-first CSS and JavaScript library with accessible components, sensible defaults, and zero dependencies.</p>
      <div class="hero-actions">
        <a href={`${base}getting-started/`} class="button">Get Started</a>
        <a href="https://github.com/ajay007e/minikit" class="button" data-style="outline">GitHub</a>
      </div>
    </section>

    <section class="container">
      <div class="section-heading">
        <h2>Simple HTML. Beautiful interfaces.</h2>
        <p class="text-muted">MiniKit embraces semantic HTML. Write familiar markup and get modern, accessible components with minimal CSS and JavaScript.</p>
      </div>
      <Playground />
    </section>

    <section class="container">
      <div class="section-heading">
        <h2>Small footprint. Big capabilities.</h2>
        <p class="text-muted">Everything you need to build modern interfaces without unnecessary complexity.</p>
      </div>
      <div class="stats">
        <article class="stat">
          <strong>15</strong>
          <span>Components</span>
        </article>
        <article class="stat">
          <strong>6.8 KB</strong>
          <span>CSS (gzip)</span>
        </article>
        <article class="stat">
          <strong>2.7 KB</strong>
          <span>JavaScript (gzip)</span>
        </article>
        <article class="stat">
          <strong>0</strong>
          <span>Dependencies</span>
        </article>
      </div>
    </section>

    <section class="container features">
      <div class="section-heading">
        <h2>Everything you need. Nothing you don't.</h2>
        <p class="text-muted">A focused collection of components and utilities for building modern websites.</p>
      </div>
      <div class="feature-grid">
        <article data-card>
          <h3>HTML First</h3>
          <p>Build interfaces using semantic HTML instead of framework abstractions.</p>
        </article>
        <article data-card>
          <h3>Tiny Bundle</h3>
          <p>Just 6.8 KB of CSS and 2.7 KB of JavaScript.</p>
        </article>
        <article data-card>
          <h3>Accessible</h3>
          <p>Keyboard-friendly components with sensible defaults.</p>
        </article>
        <article data-card>
          <h3>Framework Agnostic</h3>
          <p>Works with React, Vue, HTMX, Alpine or plain HTML.</p>
        </article>
      </div>
    </section>
  </main>
  <script is:inline src={`${import.meta.env.BASE_URL}/scripts/playground.js`}></script>
</BaseLayout>
