---
import BaseLayout from '../layouts/base-layout.astro';

import '../styles/home.css';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Page Not Found" description="The requested page could not be found.">
  <section class="container not-found">
    <span data-badge data-variant="secondary">Page Not Found</span>
    <h1>404</h1>
    <p class="lead">The page you're looking for doesn't exist or may have been moved.</p>
    <div class="hero-actions">
      <a href={base} class="button">Go Home</a>

      <a href={`${base}getting-started/`} class="button outline">Documentation</a>
    </div>
  </section>
</BaseLayout>
