---
import ComponentLayout from '../../../layouts/component-layout.astro';

import Example from '../../../components/example.astro';

const selectExample = `<select>
  <option>Choose an option</option>
  <option value="1">Option 1</option>
  <option value="2">Option 2</option>
</select>`;

const checkboxExample = `<label>
  <input type="checkbox" />
  Accept terms and conditions
</label>`;

const statesExample = `<input type="text" value="Disabled input" disabled/>
<input type="text" value="Readonly input" readonly/>
<input type="email" placeholder="Required field" required/>`;

const completeForm = `<form>
  <label>
    Full Name
    <input type="text" placeholder="John Doe"/>
  </label>

  <label>
    Email Address
    <input type="email" placeholder="john@example.com"/>
  </label>

  <label>
    Message
    <textarea rows="4"></textarea>
  </label>

  <label>
    <input type="checkbox"/>
    Subscribe to updates
  </label>

  <button type="submit">
    Submit
  </button>
</form>`;
---

<ComponentLayout
  slug="forms"
  title="Forms"
  description="Collect and validate user input using native form controls."
  nav={[
    { href: '#overview', label: 'Overview' },
    { href: '#field', label: 'Field Structure' },
    { href: '#email', label: 'Email Input' },
    { href: '#password', label: 'Password' },
    { href: '#validation', label: 'Validation' },
    { href: '#textarea', label: 'Textarea' },
    { href: '#select', label: 'Select' },
    { href: '#checkbox', label: 'Checkbox' },
    { href: '#radio', label: 'Radio Group' },
    { href: '#file', label: 'File Input' },
    { href: '#date', label: 'Date' },
    { href: '#datetime', label: 'Date & Time' },
    { href: '#range', label: 'Range' },
    { href: '#switch', label: 'Switch' },
    { href: '#states', label: 'States' },
    { href: '#example', label: 'Complete Form' },
    { href: '#accessibility', label: 'Accessibility' },
    { href: '#api', label: 'API' },
  ]}
>
  <section id="overview">
    <h2>Overview</h2>

    <p>
      MiniKit styles native HTML form controls instead of introducing custom
      components. This keeps forms lightweight, accessible, and framework
      agnostic while preserving familiar browser behavior.
    </p>

    <p>
      Inputs, textareas, selects, checkboxes, radios, switches, file inputs,
      date pickers, range sliders, progress indicators, and validation states
      are all styled automatically.
    </p>
  </section>

  <section id="field">
    <h2>Field Structure</h2>

    <p>
      MiniKit recommends grouping each control with its label and optional
      helper text using native HTML.
    </p>

    <Example
      code={`<label>
  Name
  <input
    type="text"
    placeholder="Enter your name"/>
</label>`}
    >
      <label>
        Name

        <input
          type="text"
          placeholder="Enter your name"
        />
      </label>
    </Example>

    <p>
      Native labels provide the best accessibility and require no additional
      MiniKit attributes.
    </p>
  </section>

  <section id="email">
    <h2>Email Input</h2>

    <p>
      Email inputs provide built-in browser validation and optimized keyboards
      on mobile devices.
    </p>

    <Example
      code={`<label>
  Email
  <input
    type="email"
    placeholder="you@example.com"/>
</label>`}
    >
      <label>
        Email

        <input
          type="email"
          placeholder="you@example.com"
        />
      </label>
    </Example>

    <p>
      Prefer the <code>email</code> input type over a generic text field
      whenever possible.
    </p>
  </section>

  <section id="password">
    <h2>Password</h2>

    <p>
      Password fields should communicate requirements before the user submits
      the form.
    </p>

    <Example
      code={`<label>
  Password

  <input
    type="password"
    aria-describedby="password-hint"/>

  <small id="password-hint">
    Must contain at least 8 characters.
  </small>
</label>`}
    >
      <label>
        Password

        <input
          type="password"
          aria-describedby="password-hint"
        />

        <small id="password-hint">
          Must contain at least 8 characters.
        </small>
      </label>
    </Example>

    <p>
      Associate helper text using
      <code>aria-describedby</code>.
    </p>
  </section>
  <section id="validation">
    <h2>Validation</h2>

    <p>
      MiniKit styles native browser validation while allowing custom validation
      messages using standard accessibility attributes.
    </p>

    <Example
      code={`<label>
  Email

  <input
    type="email"
    value="invalid-email"
    aria-invalid="true"
    aria-describedby="email-error"/>

  <small id="email-error">
    Please enter a valid email address.
  </small>
</label>`}
    >
      <label>
        Email

        <input
          type="email"
          value="invalid-email"
          aria-invalid="true"
          aria-describedby="email-error"
        />

        <small id="email-error">
          Please enter a valid email address.
        </small>
      </label>
    </Example>

    <p>
      Mark invalid fields using
      <code>aria-invalid="true"</code> and associate the error message using
      <code>aria-describedby</code>.
    </p>
  </section>

  <section id="textarea">
    <h2>Textarea</h2>

    <p>
      Use a textarea for multi-line user input such as comments, messages, and
      descriptions.
    </p>

    <Example
      code={`<label>
  Message

  <textarea
    rows="4"
    placeholder="Your message..."></textarea>
</label>`}
    >
      <label>
        Message

        <textarea
          rows="4"
          placeholder="Your message..."
        ></textarea>
      </label>
    </Example>
  </section>

  <section id="select">
    <h2>Select</h2>

    <p>
      Select menus allow users to choose a single option from a predefined list.
    </p>

    <Example code={selectExample}>
      <label>
        Country

        <select>
          <option>Choose an option</option>

          <option>Option 1</option>

          <option>Option 2</option>
        </select>
      </label>
    </Example>
  </section>

  <section id="checkbox">
    <h2>Checkbox</h2>

    <p>
      Checkboxes allow users to enable one or more independent options.
    </p>

    <Example code={checkboxExample}>
      <label>
        <input type="checkbox" />

        Accept terms and conditions
      </label>
    </Example>
  </section>

  <section id="radio">
    <h2>Radio Group</h2>

    <p>
      Radio buttons allow users to select exactly one option from a related
      group.
    </p>

    <Example
      code={`<fieldset>
  <legend>Preferred Plan</legend>

  <label>
    <input type="radio" name="plan"/>
    Starter
  </label>

  <label>
    <input type="radio" name="plan"/>
    Professional
  </label>

  <label>
    <input type="radio" name="plan"/>
    Enterprise
  </label>
</fieldset>`}
    >
      <fieldset>
        <legend>Preferred Plan</legend>

        <label>
          <input type="radio" name="plan-demo" />

          Starter
        </label>

        <label>
          <input type="radio" name="plan-demo" />

          Professional
        </label>

        <label>
          <input type="radio" name="plan-demo" />

          Enterprise
        </label>
      </fieldset>
    </Example>

    <p>
      Always group related radio buttons using
      <code>&lt;fieldset&gt;</code> and
      <code>&lt;legend&gt;</code>.
    </p>
  </section>

  <section id="file">
    <h2>File Input</h2>

    <p>
      File inputs allow users to upload files using the browser's native file
      picker.
    </p>

    <Example
      code={`<label>
  Upload File

  <input type="file"/>
</label>`}
    >
      <label>
        Upload File

        <input type="file" />
      </label>
    </Example>
  </section>

  <section id="date">
    <h2>Date Input</h2>

    <p>
      Date inputs use the browser's native calendar picker.
    </p>

    <Example
      code={`<label>
  Date

  <input type="date"/>
</label>`}
    >
      <label>
        Date

        <input type="date" />
      </label>
    </Example>
  </section>

  <section id="datetime">
    <h2>Date &amp; Time</h2>

    <p>
      Use a datetime input when both a date and time are required.
    </p>

    <Example
      code={`<label>
  Meeting Time

  <input type="datetime-local"/>
</label>`}
    >
      <label>
        Meeting Time

        <input type="datetime-local" />
      </label>
    </Example>

    <p>
      The browser provides a native interface for selecting both values
      together.
    </p>
  </section>
  <section id="range">
    <h2>Range Slider</h2>

    <p>
      Range sliders allow users to select a numeric value within a fixed range.
      They are commonly used for settings such as volume, brightness, or zoom.
    </p>

    <Example
      code={`<label>
  Volume

  <input
    type="range"
    min="0"
    max="100"
    value="50"/>

  <small>
    Adjust the output volume.
  </small>
</label>`}
    >
      <label>
        Volume

        <input
          type="range"
          min="0"
          max="100"
          value="50"
        />

        <small>
          Adjust the output volume.
        </small>
      </label>
    </Example>

    <p>
      Configure the slider using the
      <code>min</code>,
      <code>max</code>, and
      <code>value</code> attributes.
    </p>
  </section>

  <section id="switch">
    <h2>Switch</h2>

    <p>
      Switches represent settings that can be turned on or off immediately.
      They are implemented using a checkbox with
      <code>role="switch"</code>.
    </p>

    <Example
      code={`<label>
  Enable notifications

  <input
    type="checkbox"
    role="switch"/>

  <small>
    Receive email notifications.
  </small>
</label>`}
    >
      <label>
        Enable notifications

        <input
          type="checkbox"
          role="switch"
        />

        <small>
          Receive email notifications.
        </small>
      </label>
    </Example>

    <p>
      Use switches for settings that take effect immediately. Use checkboxes
      for options submitted with a form.
    </p>
  </section>

  <section id="states">
    <h2>States</h2>

    <p>
      MiniKit supports the browser's native disabled, readonly, required and
      invalid states.
    </p>

    <Example code={statesExample}>
      <div class="vstack">
        <input
          type="text"
          value="Disabled input"
          disabled
        />

        <input
          type="text"
          value="Readonly input"
          readonly
        />

        <input
          type="email"
          placeholder="Required field"
          required
        />
      </div>
    </Example>
  </section>

  <section id="example">
    <h2>Complete Form</h2>

    <p>
      A complete form combines multiple field types while preserving native HTML
      semantics and accessibility.
    </p>

    <Example code={completeForm}>
      <form>
        <label>
          Full Name

          <input
            type="text"
            placeholder="John Doe"
          />
        </label>

        <label>
          Email Address

          <input
            type="email"
            placeholder="john@example.com"
          />
        </label>

        <label>
          Password

          <input
            type="password"
            aria-describedby="password-demo"
          />

          <small id="password-demo">
            Must contain at least 8 characters.
          </small>
        </label>

        <label>
          Country

          <select>
            <option>Select a country</option>

            <option>Australia</option>

            <option>Canada</option>

            <option>United Kingdom</option>
          </select>
        </label>

        <label>
          Message

          <textarea
            rows="4"
            placeholder="Your message..."
          ></textarea>
        </label>

        <label>
          <input type="checkbox" />

          Subscribe to updates
        </label>

        <button type="submit">
          Submit
        </button>
      </form>
    </Example>
  </section>
  <section id="accessibility">
    <h2>Accessibility</h2>

    <p>
      MiniKit relies on native HTML form controls, preserving browser
      accessibility while providing consistent styling.
    </p>

    <ul>
      <li>
        Always associate every form control with a visible
        <code>&lt;label&gt;</code>.
      </li>

      <li>
        Use <code>aria-describedby</code> to associate helper text or error
        messages with a control.
      </li>

      <li>
        Mark invalid controls using
        <code>aria-invalid="true"</code>.
      </li>

      <li>
        Group related radio buttons using
        <code>&lt;fieldset&gt;</code> and
        <code>&lt;legend&gt;</code>.
      </li>

      <li>
        Do not rely solely on placeholder text to identify a field.
      </li>

      <li>
        Use meaningful button labels such as
        <em>Save Changes</em> or
        <em>Create Account</em>.
      </li>

      <li>
        Prefer native HTML validation whenever possible.
      </li>
    </ul>
  </section>

  <section id="api">
    <h2>API</h2>

    <table>
      <thead>
        <tr>
          <th>Element / Attribute</th>
          <th>Description</th>
        </tr>
      </thead>

      <tbody>
        <tr>
          <td><code>&lt;label&gt;</code></td>
          <td>Associates descriptive text with a form control.</td>
        </tr>

        <tr>
          <td><code>&lt;small&gt;</code></td>
          <td>Displays helper text or validation messages.</td>
        </tr>

        <tr>
          <td><code>role="switch"</code></td>
          <td>Displays a checkbox using the switch appearance.</td>
        </tr>

        <tr>
          <td><code>aria-invalid="true"</code></td>
          <td>Displays the control in its invalid state.</td>
        </tr>

        <tr>
          <td><code>aria-describedby</code></td>
          <td>Associates helper or validation text with a control.</td>
        </tr>

        <tr>
          <td><code>required</code></td>
          <td>Marks a field as required.</td>
        </tr>

        <tr>
          <td><code>disabled</code></td>
          <td>Prevents user interaction.</td>
        </tr>

        <tr>
          <td><code>readonly</code></td>
          <td>Allows viewing while preventing editing.</td>
        </tr>

        <tr>
          <td><code>min</code></td>
          <td>Sets the minimum value for range, number, and date inputs.</td>
        </tr>

        <tr>
          <td><code>max</code></td>
          <td>Sets the maximum value for range, number, and date inputs.</td>
        </tr>

        <tr>
          <td><code>value</code></td>
          <td>Specifies the initial value of a control.</td>
        </tr>
      </tbody>
    </table>
  </section>
</ComponentLayout>
