---
import ComponentLayout from '../../../layouts/component-layout.astro';

import Example from '../../../components/example.astro';
---

<ComponentLayout
  slug="progress"
  title="Progress"
  description="Display the completion status of a task or operation."
  nav={[
    {
      href: '#overview',
      label: 'Overview',
    },
    {
      href: '#basic',
      label: 'Basic Usage',
    },
    {
      href: '#value',
      label: 'Progress Values',
    },
    {
      href: '#sizes',
      label: 'Sizes',
    },
    {
      href: '#accessibility',
      label: 'Accessibility',
    },
    {
      href: '#api',
      label: 'API',
    },
  ]}
>
  <section id="overview">
    <h2>Overview</h2>

    <p>
      Progress indicators communicate the completion status of a task, upload, download, or other
      long-running operation.
    </p>

    <p>
      MiniKit styles the native
      <code>&lt;progress&gt;</code> element, providing a consistent appearance while preserving browser
      accessibility and semantics.
    </p>
  </section>

  <section id="basic">
    <h2>Basic Usage</h2>

    <p>
      Specify the current progress using the
      <code>value</code> and <code>max</code> attributes.
    </p>

    <Example
      code={`<progress
  value="40"
  max="100"
></progress>`}
    >
      <progress value="40" max="100"></progress>
    </Example>
  </section>

  <section id="value">
    <h2>Progress Values</h2>

    <p>
      The progress bar automatically fills based on the ratio between
      <code>value</code> and <code>max</code>.
    </p>

    <Example
      code={`<div class="vstack">
  <progress
    value="25"
    max="100"
  ></progress>

  <progress
    value="50"
    max="100"
  ></progress>

  <progress
    value="75"
    max="100"
  ></progress>

  <progress
    value="100"
    max="100"
  ></progress>
</div>`}
    >
      <div class="vstack">
        <progress value="25" max="100"></progress>

        <progress value="50" max="100"></progress>

        <progress value="75" max="100"></progress>

        <progress value="100" max="100"></progress>
      </div>
    </Example>

    <p>
      Update the <code>value</code> attribute dynamically to reflect progress as an operation completes.
    </p>
  </section>

  <section id="sizes">
    <h2>Sizes</h2>

    <p>Progress elements automatically stretch to fill the available width of their container.</p>

    <Example
      code={`<div class="vstack">
  <progress
    value="35"
    max="100"
  ></progress>

  <div style="max-width: 20rem;">
    <progress
      value="70"
      max="100"
    ></progress>
  </div>
</div>`}
    >
      <div class="vstack">
        <progress value="35" max="100"></progress>

        <div style="max-width:20rem;">
          <progress value="70" max="100"></progress>
        </div>
      </div>
    </Example>

    <p>
      Control the width using the parent container instead of modifying the progress element
      directly.
    </p>
  </section>

  <section id="accessibility">
    <h2>Accessibility</h2>

    <p>
      The native <code>&lt;progress&gt;</code> element provides built-in accessibility support for assistive
      technologies.
    </p>

    <ul>
      <li>Always specify a meaningful maximum value.</li>

      <li>Associate the progress indicator with nearby descriptive text.</li>

      <li>
        For long-running operations, communicate completion using both visual progress and textual
        updates.
      </li>
    </ul>
  </section>

  <section id="api">
    <h2>API</h2>
    <table>
      <thead>
        <tr>
          <th>Attribute</th>
          <th>Description</th>
        </tr>
      </thead>

      <tbody>
        <tr>
          <td><code>value</code></td>
          <td>The current progress value.</td>
        </tr>

        <tr>
          <td><code>max</code></td>
          <td>The maximum progress value.</td>
        </tr>
      </tbody>
    </table>
  </section>
</ComponentLayout>
