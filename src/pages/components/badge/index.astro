---
import ComponentLayout from '../../../layouts/component-layout.astro';

import Example from '../../../components/example.astro';

const basicBadge = `<span data-badge>Badge</span>`;

const variantsBadge = `<div class="hstack">
  <span data-badge>Default</span>
  <span data-badge data-variant="secondary">Secondary</span>
  <span data-badge data-variant="success">Success</span>
  <span data-badge data-variant="warning">Warning</span>
  <span data-badge data-variant="danger">Danger</span>
</div>`;

const outlineBadge = `<div class="hstack">
  <span data-badge data-style="outline">Default</span>
  <span data-badge data-style="outline" data-variant="secondary">Secondary</span>
  <span data-badge data-style="outline" data-variant="success">Success</span>
  <span data-badge data-style="outline" data-variant="warning">Warning</span>
  <span data-badge data-style="outline" data-variant="danger">Danger</span>
</div>`;

const sizesBadge = `<div class="hstack">
  <span data-badge data-size="sm">Small</span>
  <span data-badge>Default</span>
  <span data-badge data-size="lg">Large</span>
</div>`;
---

<ComponentLayout
  slug="badge"
  title="Badge"
  description="Display short labels, statuses, and metadata."
  nav={[
    {
      href: '#overview',
      label: 'Overview',
    },
    {
      href: '#basic',
      label: 'Basic Usage',
    },
    {
      href: '#variants',
      label: 'Variants',
    },
    {
      href: '#outline',
      label: 'Outline',
    },
    {
      href: '#sizes',
      label: 'Sizes',
    },
    {
      href: '#accessibility',
      label: 'Accessibility',
    },
    {
      href: '#api',
      label: 'API',
    },
  ]}
>
  <section id="overview">
    <h2>Overview</h2>

    <p>
      Badges are compact visual indicators used to display status, categories, counts, and metadata.
      MiniKit provides several badge variants for communicating information while maintaining a
      consistent visual language across your application.
    </p>
  </section>

  <section id="basic">
    <h2>Basic Usage</h2>

    <p>
      Create a badge using the <code>data-badge</code> attribute.
    </p>

    <Example code={basicBadge}>
      <span data-badge>Badge</span>
    </Example>
  </section>

  <section id="variants">
    <h2>Variants</h2>

    <p>Badges support multiple variants for different semantic meanings.</p>

    <Example code={variantsBadge}>
      <div class="hstack">
        <span data-badge>Default</span>
        <span data-badge data-variant="secondary">Secondary</span>
        <span data-badge data-variant="success">Success</span>
        <span data-badge data-variant="warning">Warning</span>
        <span data-badge data-variant="danger">Danger</span>
      </div>
    </Example>
  </section>

  <section id="outline">
    <h2>Outline</h2>
    <p>
      Use the <code>outline</code> class for a less prominent appearance.
    </p>

    <Example code={outlineBadge}>
      <div class="hstack">
        <span data-badge data-style="outline">Default</span>
        <span data-badge data-style="outline" data-variant="secondary">Secondary</span>
        <span data-badge data-style="outline" data-variant="success">Success</span>
        <span data-badge data-style="outline" data-variant="warning">Warning</span>
        <span data-badge data-style="outline" data-variant="danger">Danger</span>
      </div>
    </Example>
  </section>

  <section id="sizes">
    <h2>Sizes</h2>
    <p>Badges support small and large size modifiers.</p>
    <Example code={sizesBadge}>
      <div class="hstack">
        <span data-badge data-size="sm">Small</span>
        <span data-badge>Default</span>
        <span data-badge data-size="lg">Large</span>
      </div>
    </Example>
  </section>

  <section id="accessibility">
    <h2>Accessibility</h2>

    <p>
      Badges provide supplemental information and should not be the only method
      of communicating important status or state changes.
    </p>

    <ul>
      <li>Do not rely on color alone to convey meaning.</li>
      <li>Use descriptive badge text whenever possible.</li>
      <li>Ensure badges have sufficient color contrast against their background.</li>
      <li>When badges represent dynamic values or notifications, provide accessible context nearby.</li>
    </ul>
  </section>

  <section id="api">
    <h2>API</h2>

    <table>
      <thead>
        <tr>
          <th>Attribute</th>
          <th>Applies To</th>
          <th>Description</th>
        </tr>
      </thead>

      <tbody>
        <tr>
          <td><code>data-badge</code></td>
          <td><code>&lt;span&gt;</code></td>
          <td>Creates a MiniKit badge.</td>
        </tr>

        <tr>
          <td><code>data-variant="secondary"</code></td>
          <td><code>&lt;span&gt;</code></td>
          <td>Displays the secondary badge variant.</td>
        </tr>

        <tr>
          <td><code>data-variant="success"</code></td>
          <td><code>&lt;span&gt;</code></td>
          <td>Displays the success badge variant.</td>
        </tr>

        <tr>
          <td><code>data-variant="warning"</code></td>
          <td><code>&lt;span&gt;</code></td>
          <td>Displays the warning badge variant.</td>
        </tr>

        <tr>
          <td><code>data-variant="danger"</code></td>
          <td><code>&lt;span&gt;</code></td>
          <td>Displays the danger badge variant.</td>
        </tr>

        <tr>
          <td><code>data-style="outline"</code></td>
          <td><code>&lt;span&gt;</code></td>
          <td>Displays the outline badge style.</td>
        </tr>

        <tr>
          <td><code>data-size="sm"</code></td>
          <td><code>&lt;span&gt;</code></td>
          <td>Displays a small badge.</td>
        </tr>

        <tr>
          <td><code>data-size="lg"</code></td>
          <td><code>&lt;span&gt;</code></td>
          <td>Displays a large badge.</td>
        </tr>
      </tbody>
    </table>
  </section>
</ComponentLayout>
