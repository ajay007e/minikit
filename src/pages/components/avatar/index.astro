---
import ComponentLayout from '../../../layouts/component-layout.astro';

import Example from '../../../components/example.astro';

const basicAvatar = `<figure data-variant="avatar">
  AJ
</figure>`;

const imageAvatar = `<figure data-variant="avatar">
  <img
    src="https://i.pravatar.cc/100"
    alt="User avatar"
  />
</figure>`;

const avatarSizes = `<div class="hstack">
  <figure
    data-variant="avatar"
    class="small"
  >
    AJ
  </figure>

  <figure data-variant="avatar">
    AJ
  </figure>

  <figure
    data-variant="avatar"
    class="large"
  >
    AJ
  </figure>
</div>`;

const avatarGroup = `<figure
  data-variant="avatar"
  role="group"
>
  <figure data-variant="avatar">
    AJ
  </figure>

  <figure data-variant="avatar">
    MK
  </figure>

  <figure data-variant="avatar">
    JS
  </figure>
</figure>`;
---

<ComponentLayout
  slug="avatar"
  title="Avatar"
  description="Represent users with images, initials, or grouped avatars."
  nav={[
    {
      href: '#overview',
      label: 'Overview',
    },
    {
      href: '#basic',
      label: 'Basic Usage',
    },
    {
      href: '#image',
      label: 'Images',
    },
    {
      href: '#sizes',
      label: 'Sizes',
    },
    {
      href: '#group',
      label: 'Groups',
    },
    {
      href: '#accessibility',
      label: 'Accessibility',
    },
    {
      href: '#api',
      label: 'API',
    },
  ]}
>
  <section id="overview">
    <h2>Overview</h2>

    <p>
      Avatars visually represent users, teams, or entities. They can display profile images,
      initials, or be combined into groups to represent multiple users.
    </p>

    <p>
      MiniKit provides avatar components with support for images, initials, sizing options, and
      grouped layouts.
    </p>
  </section>

  <section id="basic">
    <h2>Basic Usage</h2>

    <p>Use initials when a profile image is not available.</p>

    <Example code={basicAvatar}>
      <figure data-variant="avatar">AJ</figure>
    </Example>
  </section>

  <section id="image">
    <h2>Images</h2>

    <p>Display profile images inside the avatar component.</p>

    <Example code={imageAvatar}>
      <figure data-variant="avatar">
        <img src="https://i.pravatar.cc/100" alt="User avatar" />
      </figure>
    </Example>
  </section>

  <section id="sizes">
    <h2>Sizes</h2>

    <p>Avatars support small, default, and large sizes.</p>

    <Example code={avatarSizes}>
      <div class="hstack">
        <figure data-variant="avatar" class="small">AJ</figure>

        <figure data-variant="avatar">AJ</figure>

        <figure data-variant="avatar" class="large">AJ</figure>
      </div>
    </Example>
  </section>

  <section id="group">
    <h2>Avatar Groups</h2>

    <p>Group multiple avatars together to represent teams, members, or participants.</p>

    <Example code={avatarGroup}>
      <figure data-variant="avatar" role="group">
        <figure data-variant="avatar">AJ</figure>

        <figure data-variant="avatar">MK</figure>

        <figure data-variant="avatar">JS</figure>
      </figure>
    </Example>
  </section>

  <section id="accessibility">
    <h2>Accessibility</h2>

    <p>
      When displaying user images, provide meaningful alternative text using the <code>alt</code> attribute.
    </p>

    <p>
      Initial-based avatars should be accompanied by nearby text when the identity of the user is
      important to understanding the interface.
    </p>
  </section>

  <section id="api">
    <h2>API</h2>

    <table>
      <thead>
        <tr>
          <th>Attribute</th>
          <th>Description</th>
        </tr>
      </thead>

      <tbody>
        <tr>
          <td><code>data-variant="avatar"</code></td>
          <td>Creates an avatar component.</td>
        </tr>

        <tr>
          <td><code>role="group"</code></td>
          <td>Creates an avatar group.</td>
        </tr>

        <tr>
          <td><code>small</code></td>
          <td>Applies the small avatar size.</td>
        </tr>

        <tr>
          <td><code>large</code></td>
          <td>Applies the large avatar size.</td>
        </tr>
      </tbody>
    </table>
  </section>
</ComponentLayout>
