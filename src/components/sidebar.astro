---
import { navigation } from '../data/navigation';

interface Props {
  page?: string;
}

const { page = '' } = Astro.props;

const base = import.meta.env.BASE_URL;

const currentGroup = navigation.find((group) => group.items.some((item) => item.page === page));

const currentItem = currentGroup?.items.find((item) => item.page === page);
---

<header
  class="mobile-docs-header"
  id="sidebar-toggle"
  role="button"
  tabindex="0"
  aria-label="Open navigation"
  aria-expanded="false"
  aria-controls="mobile-sidebar"
>
  <button type="button" class="ghost sidebar-toggle" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
      <path
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        d="M4 6h16M4 12h16M4 18h16"
      >
      </path>
    </svg>
  </button>

  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <span>{currentGroup?.title ?? 'Documentation'}</span>

    {
      currentItem && (
        <>
          <span>/</span>
          <strong>{currentItem.title}</strong>
        </>
      )
    }
  </nav>
</header>

<div class="mobile-sidebar-overlay"></div>

<aside class="mobile-sidebar" id="mobile-sidebar">
  <div class="mobile-sidebar-header">
    <strong>Navigation</strong>

    <button
      type="button"
      class="ghost sidebar-toggle"
      id="sidebar-close"
      aria-label="Close navigation"
    >
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
        <path
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          d="M6 6l12 12M18 6L6 18"
        >
        </path>
      </svg>
    </button>
  </div>

  {
    navigation.map((group) => {
      const hasActiveItem = group.items.some((item) => item.page === page);

      return (
        <details class="sidebar-group" open={hasActiveItem}>
          <summary>{group.title}</summary>

          <nav>
            {group.items.map((item) => (
              <a
                href={`${base}${item.href.replace(/^\//, '')}`}
                class={item.page === page ? 'active' : ''}
              >
                {item.title}
              </a>
            ))}
          </nav>
        </details>
      );
    })
  }
</aside>

<aside class="sidebar">
  {
    navigation.map((group) => {
      const hasActiveItem = group.items.some((item) => item.page === page);

      return (
        <details class="sidebar-group" open={hasActiveItem}>
          <summary>{group.title}</summary>

          <nav>
            {group.items.map((item) => (
              <a
                href={`${base}${item.href.replace(/^\//, '')}`}
                class={item.page === page ? 'active' : ''}
              >
                {item.title}
              </a>
            ))}
          </nav>
        </details>
      );
    })
  }
</aside>
