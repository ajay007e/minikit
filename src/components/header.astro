---
const base = import.meta.env.BASE_URL;
---

<header class="site-header">
  <div class="container">
    <nav class="navbar">
      <a href={base} class="brand">MiniKit</a>

      <div class="navbar-actions">
        <a href={`${base}getting-started/`} class="btn">Docs</a>

        <span class="divider"></span>

        <a
          href="https://github.com/ajay007e/minikit"
          target="_blank"
          rel="noopener"
          aria-label="GitHub"
          class="icon-link"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path
              fill="currentColor"
              d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.85 10.91.57.1.78-.25.78-.55v-2.15c-3.19.69-3.86-1.35-3.86-1.35-.52-1.31-1.27-1.66-1.27-1.66-1.04-.71.08-.7.08-.7 1.15.08 1.75 1.18 1.75 1.18 1.02 1.76 2.68 1.25 3.33.96.1-.74.4-1.25.72-1.54-2.55-.29-5.23-1.27-5.23-5.68 0-1.26.45-2.29 1.18-3.09-.12-.29-.51-1.47.11-3.06 0 0 .96-.31 3.15 1.18a10.96 10.96 0 0 1 5.74 0c2.18-1.49 3.14-1.18 3.14-1.18.63 1.59.24 2.77.12 3.06.73.8 1.18 1.83 1.18 3.09 0 4.42-2.69 5.39-5.25 5.67.41.35.78 1.04.78 2.1v3.11c0 .31.2.66.79.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"
            >
            </path>
          </svg>
        </a>

        <button class="theme-toggle" data-icon data-style="ghost" data-theme-toggle aria-label="Toggle theme">
          <svg class="moon-icon" viewBox="0 0 24 24" width="18" height="18">
            <path
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              d="M21 12.79A9 9 0 1 1 11.21 3c0 .28 0 .57.02.85A7 7 0 0 0 20.15 12c.28 0 .57 0 .85-.02z"
            >
            </path>
          </svg>

          <svg class="sun-icon" viewBox="0 0 24 24" width="18" height="18">
            <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2">
            </circle>

            <path
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              d="M12 2v2M12 20v2M2 12h2M20 12h2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
            >
            </path>
          </svg>
        </button>
      </div>
    </nav>
  </div>
</header>
