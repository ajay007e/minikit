<div class="playground">
  <!-- Preview -->

  <div class="playground-preview">
    <div class="playground-preview-inner" id="playground-preview"></div>
  </div>

  <!-- Editor -->

  <div class="playground-editor">
    <div class="playground-editor-header">
      <div class="playground-editor-title">
        <span class="dot red"></span>
        <span class="dot yellow"></span>
        <span class="dot green"></span>

        <span>playground.html</span>
      </div>

      <span class="playground-language">HTML</span>
    </div>

    <pre class="playground-code"><code id="playground-code" class="language-html" /></pre>
  </div>
</div>

<script>
  import '../scripts/playground.js';
</script>
